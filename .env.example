# AI Work Memory Environment Configuration
APP_NAME=AI Work Memory
APP_ENV=development
LOG_LEVEL=INFO

# FastAPI Server Configuration
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# Supabase PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
# 1. Connection Pooling String (Recommended for Supabase):
# SUPABASE_DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# 2. Or Direct Connection String:
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
#
# 3. Optional Supabase API Credentials:
# SUPABASE_URL=https://[ref].supabase.co
# SUPABASE_KEY=your-supabase-anon-or-service-key
#
# For Local SQLite testing fallback:
DATABASE_URL=sqlite:///./ai_work_memory.db
